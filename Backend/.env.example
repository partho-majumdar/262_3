# ===========================================================================
# Example environment configuration.
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# ===========================================================================

# --- Paths ----------------------------------------------------------------
# Directory holding trained checkpoints. A modality with no checkpoint here is
# reported as UNAVAILABLE by the API - it is never faked.
MODEL_DIR=checkpoints
# Raw dataset + collected artifacts. Git-ignored by design.
DATA_DIR=data
REPORTS_DIR=reports
LOGS_DIR=logs
# Absolute or relative path to the PhiUSIIL CSV. Inspection reads this file.
# Measured for this checkout: 54,160,642 bytes, 235,795 rows, 55 columns.
PHIUSIIL_CSV=../Dataset/Phishing_URL_Dataset.csv

# --- Runtime --------------------------------------------------------------
# auto | cpu | cuda   ("auto" selects CUDA only if torch reports it available)
DEVICE=auto
LOG_LEVEL=INFO
# Emit one JSON object per log record to stdout.
LOG_FORMAT=json

# --- URL input limits -----------------------------------------------------
# Hard cap on submitted URL length; longer input is rejected with 400.
MAX_URL_LENGTH=2048
# Only http/https are ever accepted.
ALLOWED_SCHEMES=http,https

# --- Secure fetcher (P3) --------------------------------------------------
REQUEST_TIMEOUT=10
CONNECT_TIMEOUT=5
# Hard streaming download cap. The body is aborted the moment it is exceeded.
MAX_RESPONSE_SIZE_MB=5
MAX_REDIRECTS=5
# Restricted port allowlist. Non-listed ports are refused before any socket is opened.
ALLOWED_PORTS=80,443
# Only these response content types are accepted as pages.
ALLOWED_CONTENT_TYPES=text/html,application/xhtml+xml
# Bytes of HTML actually retained for modelling (after the size cap above).
HTML_MAX_CHARS=200000
# Politeness delay between fetches to the same registrable domain.
FETCH_DELAY_SECONDS=1.0
# Max concurrent fetch workers during collection.
FETCH_CONCURRENCY=8
# Per-domain request budget for one collection batch.
FETCH_MAX_PER_DOMAIN=1

# --- Screenshot service (P3) ---------------------------------------------
SCREENSHOT_TIMEOUT=20000
SCREENSHOT_WIDTH=1280
SCREENSHOT_HEIGHT=800
SCREENSHOT_NAV_TIMEOUT_MS=15000
# Base URL of the isolated Chromium container (never localhost in production).
SCREENSHOT_SERVICE_URL=http://screenshot-service:8000

# --- URL model ------------------------------------------------------------
URL_MAX_LENGTH=256

# --- Rate limiting --------------------------------------------------------
# Requests per window per client IP on POST /api/analyze.
RATE_LIMIT_PER_MINUTE=10

# --- Storage --------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db
# HTML and screenshots are NEVER persisted unless this is explicitly true.
ALLOW_STORE_ARTIFACTS=false
# Base64-encode artifacts into the API response instead of writing temp files.
RETURN_ARTIFACTS_INLINE=true

# --- Data collection policy (documented in docs/data_collection.md) -------
# Respect robots.txt / Terms of Service of every collected host.
RESPECT_ROBOTS=true
COLLECTION_USER_AGENT=MMRESearchBot/1.0 (+academic research; contact: set-your-email@example.com)
